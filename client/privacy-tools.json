  {
    "id": "private_fact_prove",
    "tool": "seconded_private_fact_prove",
    "status": "in_testing",
    "price_usd": "0.00",
    "execution": "agent_local",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "fact"
            },
            "attestation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "envelope": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "product": {
                      "type": "string",
                      "enum": [
                        "trade_check",
                        "token_check",
                        "stock_token_check",
                        "full_stock_check",
                        "cross_chain_compare",
                        "lending_check"
                      ]
                    },
                    "chain": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^eip155:[1-9][0-9]{0,15}$"
                    },
                    "subject": {
                      "type": "string",
                      "maxLength": 42,
                      "pattern": "^0x[0-9a-f]{40}$"
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "fail",
                        "unknown",
                        "agreed",
                        "no_agreement",
                        "content_refused",
                        "service_failed"
                      ]
                    },
                    "policy_version": {
                      "type": "string",
                      "maxLength": 32,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,31}$"
                    },
                    "issued_day": {
                      "type": "string",
                      "maxLength": 10,
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "expiry": {
                      "type": "string",
                      "maxLength": 10,
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "type": {
                      "const": "seconded-fact-attestation/v1"
                    },
                    "salt": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "key_id": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  },
                  "required": [
                    "product",
                    "chain",
                    "subject",
                    "outcome",
                    "policy_version",
                    "issued_day",
                    "expiry",
                    "type",
                    "salt",
                    "key_id"
                  ]
                },
                "sig": {
                  "type": "string",
                  "maxLength": 86,
                  "pattern": "^[A-Za-z0-9_-]{86}$"
                },
                "key_id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "required": [
                "envelope",
                "sig",
                "key_id"
              ]
            },
            "audience": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^https://[a-z0-9][a-z0-9.-]*(?::[0-9]{1,5})?$"
            },
            "nonce": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{32,64}$"
            },
            "expiry": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "mode",
            "attestation",
            "audience",
            "nonce",
            "expiry"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "solvency",
                "hidden_balance",
                "balance_gte"
              ]
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "description": "Fact attestations carry no direct payment identifiers. The issuer can link issuance to the originating check; repeated presentations of the same fact are linkable. Present a transferable issuer fact locally to an audience challenge. Not payment ownership, hidden balance or solvency. Issuer public keys must be independently trusted. Free. No payment, relay or custody. Unknown evidence never means safe."
  }
]
